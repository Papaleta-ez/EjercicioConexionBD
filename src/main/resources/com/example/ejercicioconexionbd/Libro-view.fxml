<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.ejercicioconexionbd.controller.LibroController">
    <children>
        <VBox alignment="CENTER" layoutX="22.0" layoutY="14.0" prefHeight="470.0" prefWidth="560.0" spacing="15.0">
            <children>
                <Label text="Registro de Libros">
                    <font>
                        <Font name="Times New Roman Bold" size="18.0" />
                    </font></Label>
                <Separator prefWidth="200.0" />
                <GridPane alignment="CENTER" prefHeight="177.0" prefWidth="560.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="273.0" minWidth="10.0" prefWidth="103.99998474121094" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="465.00001525878906" minWidth="10.0" prefWidth="456.00001525878906" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Título:">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></Label>
                        <Label text="Autor:" GridPane.rowIndex="1">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></Label>
                        <Label text="Categoría:" GridPane.rowIndex="2">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></Label>
                        <Label text="Precio:" GridPane.rowIndex="3">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></Label>
                        <Label text="Stock:" GridPane.rowIndex="4">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></Label>
                        <TextField fx:id="txtTitulo" promptText="Ingrese el título del libro" GridPane.columnIndex="1">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></TextField>
                        <TextField fx:id="txtAutor" promptText="Ingrese el nombre del autor" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></TextField>
                        <TextField fx:id="txtPrecio" promptText="Ingrese el precio" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></TextField>
                        <TextField fx:id="txtStock" promptText="Ingrese la cantidad" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <font>
                                <Font name="Times New Roman" size="14.0" />
                            </font></TextField>
                        <ComboBox fx:id="cmbCategoria" prefHeight="26.0" prefWidth="455.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                </GridPane>
                <Separator prefWidth="200.0" />
                <HBox alignment="CENTER" prefHeight="51.0" prefWidth="560.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarLibro" text="Guardar">
                            <font>
                                <Font name="Times New Roman Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarRegistro" text="Limpiar">
                            <font>
                                <Font name="Times New Roman Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarRegistro" text="Actualizar">
                            <font>
                                <Font name="Times New Roman Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
                <Separator prefWidth="200.0" />
                <TableView fx:id="tblLibro" prefHeight="200.0" prefWidth="560.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                        <TableColumn fx:id="colTitulo" prefWidth="75.0" text="Título" />
                        <TableColumn fx:id="colAutor" prefWidth="75.0" text="Autor" />
                        <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
                        <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
